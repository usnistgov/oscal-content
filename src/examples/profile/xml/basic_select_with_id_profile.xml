<?xml version="1.0" encoding="UTF-8"?>
<profile xmlns="http://csrc.nist.gov/ns/oscal/1.0" uuid="67d9de4a-cfd3-4abe-9a06-b8a13f5551cc">
  <metadata>
    <title>Sample Security Profile <em>For Demonstration</em> and Testing
    </title>
      <published>2026-05-13T12:30:00.00000-00:00</published>
      <last-modified>2026-05-12T02:46:09.00000-00:00</last-modified>
    <version>1.1.0</version>
    <oscal-version>1.2.3</oscal-version>
    <remarks>
      <p>The following document is used in the OSCAL Profile Tutorial and builds on the catalog created for the OSCAL Catalog Tutorial</p>
    </remarks>
  </metadata>
  <import href="../../catalog/xml/basic_catalog.xml">
    <include-controls>
      <matching pattern="s*.2"/>
    </include-controls>
    <include-controls>
      <with-id>s1.1.1</with-id>
    </include-controls>
    <exclude-controls>
        <with-id>s2.1.2</with-id>
    </exclude-controls>
  </import>
  <merge>
    <flat/>
  </merge>
  <modify>
    <set-parameter param-id="s1.1.1-prm_2">
      <label>a duration (maximum 30 minutes)</label>
    </set-parameter>
    <alter control-id="s1.1.1">
      <add position="after" by-id="s1.1.1_gdn.3">
        <part id="s1.1.1_gdn.4" name="assessment-objective" class="assessment-objective">
          <p>Users of devices running Gnome may adjust the inactivity timeout using the following link: https://help.gnome.org/admin/system-admin-guide/stable/desktop-lockscreen.html.en</p>
        </part>
      </add>
    </alter>
  </modify>
</profile>